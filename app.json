{
  "expo": {
    "name": "victory-fitness",
    "slug": "victora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "victoryfitness",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSHealthShareUsageDescription": "Victory Fitness reads your health data to power Longevity OS insights and recovery tracking.",
        "NSHealthUpdateUsageDescription": "Victory Fitness writes health updates only when you choose to sync your wellness data."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.victory.fitness",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-audio",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 26
          }
        }
      ],
      "expo-health-connect",
      [
        "react-native-health",
        {
          "healthSharePermission": "Victory Fitness reads your Apple Health data to power Longevity OS insights and recovery tracking.",
          "healthUpdatePermission": "Victory Fitness writes health updates only when you choose to sync your wellness data."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b745c8ed-3483-4e3c-8c77-923cce1c5376"
      }
    },
    "owner": "miskat"
  }
}
